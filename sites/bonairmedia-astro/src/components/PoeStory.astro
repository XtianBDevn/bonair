---
import { SITE } from '../lib/site';
import PixelPoe from './PixelPoe.astro';
import type { Expression } from '../mascot/expressions';

type Beat = { poe: Expression; christian: Expression; screen: string; line: string };

const BEATS: Beat[] = [
  {
    poe: 'excited',
    christian: 'happy',
    screen: 'title',
    line: 'Quoth the Raven: welcome to River City Rumble. Twenty Richmond trivia questions drop every week. You get one shot — and I keep score.',
  },
  {
    poe: 'focused',
    christian: 'thinking',
    screen: 'banner',
    line: 'Christian kept seeing the same problem with local advertising: banner ads get scrolled right past. Nobody remembers who sponsored what.',
  },
  {
    poe: 'surprised',
    christian: 'excited',
    screen: 'flip',
    line: 'So he flipped it. What if the ad isn’t sitting next to the game… what if it’s a moment inside the game?',
  },
  {
    poe: 'curious',
    christian: 'focused',
    screen: 'question',
    line: 'Every question is a beat: sponsor reveal, the question, the countdown. You’re locked in waiting on the answer — that’s exactly when the sponsor shows up.',
  },
  {
    poe: 'happy',
    christian: 'curious',
    screen: 'math',
    line: 'Twenty questions a round, every player, every week. Sponsors aren’t buying a banner — they’re buying the moments people are actually paying attention.',
  },
  {
    poe: 'wink',
    christian: 'wink',
    screen: 'cta',
    line: 'Play this week’s Rumble, or put your business in it. Nevermore waste an impression.',
  },
];
---

<div class="poe-wrap" data-poe-story>
  <div class="stage">
    <div class="window">
      <div class="titlebar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="path">rivercityrumble.com — poe.tell("the ad idea")</span>
        <span class="progress" aria-hidden="true">
          {BEATS.map((_, i) => <b data-progress={i}></b>)}
        </span>
      </div>
      <div class="body grid-paper">
        <div class="poe-slot">
          <PixelPoe class="poe" label="Poe, a pixel-art raven, talking" />
        </div>
        <div class="right">
          <div class="bubble" aria-live="polite">
            <span class="speaker">POE</span>
            <p><span data-poe-text>{BEATS[0].line}</span><span class="caret" data-caret></span></p>
          </div>

          <div class="screens">
            <div class="screen" data-screen="title">
              <div class="kicker">This week’s drop</div>
              <div class="big">River City Rumble</div>
              <div class="chips"><span>20 questions</span><span>1 shot</span><span>Richmond only</span></div>
            </div>
            <div class="screen muted" data-screen="banner">
              <div class="kicker">A typical local site</div>
              <div class="lines"><i></i><i></i><div class="ad">Ad · 728×90 · scrolled past</div><i></i><i style="width:60%"></i></div>
            </div>
            <div class="screen" data-screen="flip">
              <div class="kicker">The flip</div>
              <div class="flip"><s>Ad next to content</s><span>→</span><strong>Ad as a moment in the game</strong></div>
            </div>
            <div class="screen" data-screen="question">
              <div class="sponsor">Question 7 · presented by <em>Your business here</em></div>
              <div class="q">Which Richmond neighborhood is home to the Edgar Allan Poe Museum?</div>
              <div class="answers"><span>The Fan</span><span class="pick">Shockoe Bottom</span><span>Church Hill</span><span>Carytown</span></div>
              <div class="timer" aria-hidden="true"><b></b></div>
            </div>
            <div class="screen" data-screen="math">
              <div class="kicker">One round</div>
              <div class="grid20" aria-label="20 questions, each with a sponsor moment">
                {Array.from({ length: 20 }, (_, i) => <i style={`animation-delay:${i * 60}ms`}></i>)}
              </div>
              <div class="small">20 sponsor moments × every player × every week</div>
            </div>
            <div class="screen" data-screen="cta">
              <div class="kicker">Your move</div>
              <div class="ctas">
                <a class="btn" href={SITE.rumbleUrl} target="_blank" rel="noopener noreferrer">Play this week’s Rumble</a>
                <a class="btn btn--ghost" href="/contact?topic=river-city-rumble-sponsor">Sponsor a round</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="steps">
    {BEATS.map((b, i) => <div class="step" data-step={i} data-line={b.line} data-screen-id={b.screen} data-expression={b.christian} data-poe-expression={b.poe}></div>)}
  </div>
</div>

<style>
  .poe-wrap {
    --step: 85vh;
    position: relative;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    padding: calc(var(--header-h) + 3.5rem) 0 1.5rem;
    z-index: 1;
  }
  .steps {
    margin-top: -100vh;
  }
  .step {
    height: var(--step);
  }
  .window {
    width: 100%;
    background: var(--card);
    border: 1px solid var(--rule);
    border-left: 4px solid var(--sun);
    border-bottom: 4px solid var(--sun);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 18px 40px -24px var(--shadow);
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--rule);
    font: 500 0.72rem/1.2 'JetBrains Mono', monospace;
    color: var(--muted);
  }
  .path {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dots {
    display: flex;
    gap: 5px;
  }
  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--coral);
  }
  .dots i:nth-child(2) {
    background: var(--sun);
  }
  .dots i:nth-child(3) {
    background: var(--lavender);
  }
  .progress {
    display: flex;
    gap: 3px;
  }
  .progress b {
    width: 14px;
    height: 4px;
    border-radius: 2px;
    background: var(--rule);
    transition: background 0.3s;
  }
  .progress b.on {
    background: var(--coral);
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    min-height: min(62vh, 520px);
  }
  .poe-slot {
    display: grid;
    place-items: center;
    min-width: 0;
    padding: 1rem;
  }
  .poe-slot :global(.poe) {
    width: min(100%, 320px);
    aspect-ratio: 1;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
  .right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding: 1.25rem 1.25rem 1.5rem 0;
  }
  .bubble {
    position: relative;
    background: var(--bubble-bg);
    color: var(--bubble-fg);
    border-radius: 4px;
    box-shadow:
      0 0 0 3px var(--bubble-fg),
      0 0 0 6px var(--bubble-bg);
    padding: 0.9rem 1.1rem 1rem;
    min-height: 7.5rem;
  }
  .speaker {
    font: 400 0.6rem/1 'Press Start 2P', monospace;
    color: var(--sun);
  }
  .bubble p {
    margin: 0.5rem 0 0;
    font: 400 1.02rem/1.5 'Outfit', sans-serif;
  }
  .caret {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--coral);
    animation: blink 0.9s steps(1) infinite;
  }
  .caret.done {
    opacity: 0;
    animation: none;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .screen {
    display: none;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 1rem 1.1rem;
    animation: rise 0.45s ease both;
  }
  .screen.active {
    display: block;
  }
  .screen.muted {
    background: var(--paper-2);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .kicker {
    font: 600 0.68rem/1 'JetBrains Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--magenta);
    margin-bottom: 0.6rem;
  }
  .big {
    font: 400 2.2rem/1 'Bebas Neue', sans-serif;
    letter-spacing: 0.02em;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .chips span {
    font: 500 0.75rem/1 'JetBrains Mono', monospace;
    padding: 0.35rem 0.55rem;
    border-radius: 999px;
    background: var(--plum);
    color: var(--on-accent);
  }
  .lines {
    display: grid;
    gap: 0.45rem;
  }
  .lines i {
    display: block;
    height: 8px;
    border-radius: 4px;
    background: var(--rule);
  }
  .ad {
    font: 500 0.72rem/1 'JetBrains Mono', monospace;
    color: var(--muted);
    opacity: 0.6;
    border: 1px dashed var(--rule);
    border-radius: 6px;
    padding: 0.9rem;
    text-align: center;
  }
  .flip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    font: 500 1.05rem/1.3 'Outfit', sans-serif;
  }
  .flip s {
    color: var(--muted);
  }
  .flip strong {
    color: var(--coral);
  }
  .sponsor {
    font: 500 0.72rem/1.3 'JetBrains Mono', monospace;
    color: var(--muted);
    padding: 0.45rem 0.6rem;
    border-radius: 6px;
    background: var(--sponsor-bg);
    margin-bottom: 0.7rem;
  }
  .sponsor em {
    font-style: normal;
    font-weight: 700;
    color: var(--magenta);
  }
  .q {
    font: 600 1rem/1.35 'Outfit', sans-serif;
    margin-bottom: 0.7rem;
  }
  .answers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
  }
  .answers span {
    font: 500 0.85rem/1.2 'Outfit', sans-serif;
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 0.45rem 0.55rem;
  }
  .answers .pick {
    border-color: var(--plum);
    background: var(--plum);
    color: var(--on-accent);
  }
  .timer {
    margin-top: 0.75rem;
    height: 5px;
    border-radius: 3px;
    background: var(--rule);
    overflow: hidden;
  }
  .timer b {
    display: block;
    height: 100%;
    background: var(--coral);
    transform-origin: left;
    animation: drain 8s linear infinite;
  }
  @keyframes drain {
    from {
      transform: scaleX(1);
    }
    to {
      transform: scaleX(0);
    }
  }
  .grid20 {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 5px;
  }
  .grid20 i {
    aspect-ratio: 1;
    animation: pop 0.35s steps(3) both;
  }
  @keyframes pop {
    from {
      background: var(--rule);
      transform: scale(0.7);
    }
    to {
      background: var(--coral);
      transform: none;
    }
  }
  .small {
    margin-top: 0.7rem;
    font: 500 0.75rem/1.3 'JetBrains Mono', monospace;
    color: var(--muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .screen,
    .grid20 i,
    .timer b {
      animation: none;
    }
  }

  @media (max-width: 720px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 28vh auto;
    }
    .poe-slot :global(.poe) {
      width: auto;
      height: 100%;
    }
    .right {
      padding: 0 1rem 1rem;
      gap: 0.75rem;
    }
    .bubble {
      min-height: 8.5rem;
    }
    .bubble p {
      font-size: 0.95rem;
    }
    /* phones: the pinned window can't fit both, Poe's lines carry the story */
    .screens {
      display: none;
    }
  }
</style>

<script>
  import { prefersReducedMotion, setPoeTalking } from '../mascot/expressions';

  const root = document.querySelector<HTMLElement>('[data-poe-story]');
  if (root) {
    const text = root.querySelector<HTMLElement>('[data-poe-text]')!;
    const caret = root.querySelector<HTMLElement>('[data-caret]')!;
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const stepsWrap = root.querySelector<HTMLElement>('.steps')!;
    const screens = Array.from(root.querySelectorAll<HTMLElement>('[data-screen]'));
    const progress = Array.from(root.querySelectorAll<HTMLElement>('[data-progress]'));
    const reduced = prefersReducedMotion();

    let typer = 0;
    const say = (line: string) => {
      window.clearInterval(typer);
      if (reduced) {
        text.textContent = line;
        caret.classList.add('done');
        setPoeTalking(false);
        return;
      }
      let i = 0;
      text.textContent = '';
      caret.classList.remove('done');
      setPoeTalking(true);
      typer = window.setInterval(() => {
        i += 1;
        text.textContent = line.slice(0, i);
        if (i >= line.length) {
          window.clearInterval(typer);
          caret.classList.add('done');
          setPoeTalking(false);
        }
      }, 26);
    };

    let beat = -1;
    const show = (i: number) => {
      if (i === beat) return;
      beat = i;
      const step = steps[i];
      say(step.dataset.line ?? '');
      screens.forEach((s) => s.classList.toggle('active', s.dataset.screen === step.dataset.screenId));
      progress.forEach((p, j) => p.classList.toggle('on', j <= i));
    };

    let raf = 0;
    const measure = () => {
      raf = 0;
      const top = stepsWrap.getBoundingClientRect().top;
      const stepH = steps[0].getBoundingClientRect().height;
      const i = Math.floor((window.innerHeight * 0.45 - top) / stepH);
      show(Math.max(0, Math.min(steps.length - 1, i)));
    };
    const queue = () => {
      if (!raf) raf = requestAnimationFrame(measure);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    measure();
  }
</script>
