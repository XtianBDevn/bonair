# PostgreSQL (docker compose: infra/docker-compose.yml)
DATABASE_URL="postgresql://bonair:bonair@localhost:5433/bonair_local?schema=public"

# Auth — use a long random string in production
JWT_SECRET="change-me-to-a-32-char-or-longer-secret"

# OpenAI (optional — falls back to templates when unset)
OPENAI_API_KEY=""

# Stripe (billing — stubbed in MVP)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# App URL (auth redirects, emails)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Phase 3 — scheduled jobs + CMS webhooks
CRON_SECRET=""
CMS_WEBHOOK_SECRET=""
