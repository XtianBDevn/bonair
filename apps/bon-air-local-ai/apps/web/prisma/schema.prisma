generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String    @id @default(uuid())
  slug           String    @unique
  name           String
  planId         String?   @map("plan_id")
  isAgency       Boolean   @default(false) @map("is_agency")
  parentTenantId String?   @map("parent_tenant_id")
  brand          Json      @default("{}")
  settings       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  plan              Plan?              @relation(fields: [planId], references: [id])
  memberships       Membership[]
  subscriptions     Subscription[]
  businessLocations BusinessLocation[]
  services          Service[]
  geoPages          GeoPage[]
  gbpPosts          GbpPost[]
  aiJobs            AiJob[]
  usageEvents       UsageEvent[]
  auditEvents       AuditEvent[]
  rankKeywords      RankKeyword[]
  rankSnapshots     RankSnapshot[]
  citationListings  CitationListing[]
  competitorSnapshots CompetitorSnapshot[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  name         String?
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  memberships Membership[]
  geoPages    GeoPage[]
  auditEvents AuditEvent[]

  @@map("users")
}

model Membership {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Plan {
  id                 String  @id @default(uuid())
  code               String  @unique
  name               String
  monthlyPriceCents  Int     @map("monthly_price_cents")
  annualPriceCents   Int     @map("annual_price_cents")
  limits             Json
  features           Json    @default("[]")
  stripePriceMonthly String? @map("stripe_price_monthly")
  stripePriceAnnual  String? @map("stripe_price_annual")
  isActive           Boolean @default(true) @map("is_active")

  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  planId               String   @map("plan_id")
  stripeCustomerId     String   @map("stripe_customer_id")
  stripeSubscriptionId String   @unique @map("stripe_subscription_id")
  status               String
  currentPeriodEnd     DateTime @map("current_period_end")
  cancelAtPeriodEnd    Boolean  @default(false) @map("cancel_at_period_end")
  createdAt            DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

model BusinessLocation {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  name               String
  address            Json
  geo                Json?
  phone              String?
  website            String?
  gbpPlaceId         String?  @map("gbp_place_id")
  primaryCategory    String?  @map("primary_category")
  categories         String[] @default([])
  serviceRadiusMiles Int?     @map("service_radius_miles")
  timezone           String   @default("America/New_York")
  createdAt          DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]
  geoPages GeoPage[]
  gbpPosts GbpPost[]
  rankKeywords RankKeyword[]
  citationListings CitationListing[]
  competitorSnapshots CompetitorSnapshot[]

  @@index([tenantId])
  @@map("business_locations")
}

model Service {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  locationId  String? @map("location_id")
  name        String
  slug        String
  description String?
  metadata    Json    @default("{}")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  geoPages GeoPage[]

  @@unique([tenantId, locationId, slug])
  @@map("services")
}

model GeoPage {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  locationId       String?   @map("location_id")
  serviceId        String?   @map("service_id")
  pageType         String    @map("page_type")
  slug             String
  targetCity       String?   @map("target_city")
  targetRegion     String?   @map("target_region")
  targetGeo        Json?     @map("target_geo")
  title            String
  metaDescription  String?   @map("meta_description")
  status           String    @default("draft")
  content          Json
  schemaJsonld     Json?     @map("schema_jsonld")
  uniquenessScore  Decimal?  @map("uniqueness_score") @db.Decimal(5, 2)
  wordCount        Int?      @map("word_count")
  publishedAt      DateTime? @map("published_at")
  publishedUrl     String?   @map("published_url")
  createdById      String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location BusinessLocation? @relation(fields: [locationId], references: [id])
  service  Service?          @relation(fields: [serviceId], references: [id])
  createdBy User?            @relation(fields: [createdById], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([locationId])
  @@map("geo_pages")
}

model GbpPost {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  locationId   String    @map("location_id")
  topic        String
  ctaType      String?   @map("cta_type")
  ctaUrl       String?   @map("cta_url")
  body         String
  imageUrl     String?   @map("image_url")
  scheduledFor DateTime? @map("scheduled_for")
  status       String    @default("draft")
  postedAt     DateTime? @map("posted_at")
  gbpPostId    String?   @map("gbp_post_id")
  error        String?
  aiJobId      String?   @map("ai_job_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("gbp_posts")
}

model AiJob {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  kind          String
  status        String    @default("queued")
  input         Json
  output        Json?
  error         String?
  correlationId String?   @map("correlation_id")
  provider      String?
  model         String?
  inputTokens   Int?      @map("input_tokens")
  outputTokens  Int?      @map("output_tokens")
  costCents     Decimal?  @map("cost_cents") @db.Decimal(10, 4)
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("ai_jobs")
}

model UsageEvent {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @map("tenant_id")
  kind      String
  quantity  Decimal  @db.Decimal(12, 4)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, createdAt(sort: Desc)])
  @@map("usage_events")
}

model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  tenantId   String?  @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json     @default("{}")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_events")
}

model RankKeyword {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  locationId   String?  @map("location_id")
  keyword      String
  searchEngine String   @default("google") @map("search_engine")
  geo          Json?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location  BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  snapshots RankSnapshot[]

  @@unique([tenantId, keyword, locationId])
  @@index([tenantId])
  @@map("rank_keywords")
}

model RankSnapshot {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  keywordId  String   @map("keyword_id")
  position   Int?
  localPack  Int?     @map("local_pack")
  url        String?
  capturedAt DateTime @map("captured_at")
  source     String   @default("demo")
  metadata   Json     @default("{}")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyword RankKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([tenantId, keywordId, capturedAt(sort: Desc)])
  @@map("rank_snapshots")
}

model CitationListing {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  locationId    String    @map("location_id")
  directory     String
  listingUrl    String?   @map("listing_url")
  napName       String?   @map("nap_name")
  napPhone      String?   @map("nap_phone")
  napAddress    String?   @map("nap_address")
  status        String    @default("unknown")
  lastCheckedAt DateTime? @map("last_checked_at")
  issues        Json      @default("[]")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locationId, directory])
  @@index([tenantId, status])
  @@map("citation_listings")
}

model CompetitorSnapshot {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  locationId     String?  @map("location_id")
  competitorName String   @map("competitor_name")
  placeId        String?  @map("place_id")
  rating         Decimal? @db.Decimal(3, 2)
  reviewCount    Int?     @map("review_count")
  rankPosition   Int?     @map("rank_position")
  keyword        String?
  capturedAt     DateTime @map("captured_at")
  metadata       Json     @default("{}")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId, capturedAt(sort: Desc)])
  @@map("competitor_snapshots")
}
