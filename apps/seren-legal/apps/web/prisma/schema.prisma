generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  domain         String?
  planId         String?  @map("plan_id")
  parentTenantId String?  @map("parent_tenant_id")
  settings       Json     @default("{}")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  plan         Plan?          @relation(fields: [planId], references: [id])
  parentTenant Tenant?        @relation("TenantHierarchy", fields: [parentTenantId], references: [id])
  childTenants Tenant[]       @relation("TenantHierarchy")
  users        User[]
  attorneys    Attorney[]
  contacts     Contact[]
  leads        Lead[]
  pipelines    Pipeline[]
  pipelineStages PipelineStage[]
  intakeForms  IntakeForm[]
  intakeSessions IntakeSession[]
  communications Communication[]
  appointments Appointment[]
  automationWorkflows AutomationWorkflow[]
  workflowExecutions WorkflowExecution[]
  analyticsSnapshots AnalyticsSnapshot[]
  reviewRequests ReviewRequest[]
  subscriptions Subscription[]
  usageEvents  UsageEvent[]
  auditEvents  AuditEvent[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  email        String
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  role         String    @default("staff")
  avatarUrl    String?   @map("avatar_url")
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attorney       Attorney?
  communications Communication[]
  usageEvents    UsageEvent[]
  auditEvents    AuditEvent[]

  @@unique([tenantId, email])
  @@map("users")
}

model Attorney {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  userId                String   @unique @map("user_id")
  practiceAreas         String[] @default([]) @map("practice_areas")
  bio                   String?
  hourlyRate            Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  isAccepting           Boolean  @default(true) @map("is_accepting")
  maxDailyConsultations Int      @default(8) @map("max_daily_consultations")
  calendarProvider      String?  @map("calendar_provider")
  officeHours           Json     @default("{}") @map("office_hours")
  assignmentWeight      Int      @default(1) @map("assignment_weight")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads        Lead[]
  appointments Appointment[]

  @@index([tenantId])
  @@map("attorneys")
}

model Contact {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  email           String?
  phone           String?
  phoneNormalized String?  @map("phone_normalized")
  addressLine1    String?  @map("address_line1")
  addressCity     String?  @map("address_city")
  addressState    String?  @map("address_state")
  addressZip      String?  @map("address_zip")
  tags            String[] @default([])
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads            Lead[]
  intakeSessions   IntakeSession[]
  communications   Communication[]
  appointments     Appointment[]
  workflowExecutions WorkflowExecution[]
  reviewRequests   ReviewRequest[]

  @@index([tenantId])
  @@map("contacts")
}

model Pipeline {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  practiceArea  String?  @map("practice_area")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]

  @@map("pipelines")
}

model PipelineStage {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  pipelineId String   @map("pipeline_id")
  name       String
  position   Int
  color      String?
  isTerminal Boolean  @default(false) @map("is_terminal")
  autoAction Json?    @map("auto_action")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

model Lead {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  contactId          String    @map("contact_id")
  source             String
  sourceDetail       String?   @map("source_detail")
  practiceArea       String    @map("practice_area")
  status             String    @default("new")
  score              Int       @default(0)
  urgency            String    @default("medium")
  caseSummary        String?   @map("case_summary")
  caseTypeDetail     String?   @map("case_type_detail")
  estimatedValue     Decimal?  @map("estimated_value") @db.Decimal(12, 2)
  assignedAttorneyId String?   @map("assigned_attorney_id")
  pipelineStageId    String?   @map("pipeline_stage_id")
  lostReason         String?   @map("lost_reason")
  retainedAt         DateTime? @map("retained_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedAttorney Attorney?         @relation(fields: [assignedAttorneyId], references: [id])
  pipelineStage    PipelineStage?    @relation(fields: [pipelineStageId], references: [id])
  intakeSessions   IntakeSession[]
  communications   Communication[]
  appointments     Appointment[]
  workflowExecutions WorkflowExecution[]
  reviewRequests   ReviewRequest[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("leads")
}

model IntakeForm {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  name            String
  practiceArea    String   @map("practice_area")
  fields          Json
  isActive        Boolean  @default(true) @map("is_active")
  embedToken      String?  @unique @map("embed_token")
  settings        Json     @default("{}")
  submissionCount Int      @default(0) @map("submission_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions IntakeSession[]

  @@map("intake_forms")
}

model IntakeSession {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  leadId          String?   @map("lead_id")
  contactId       String?   @map("contact_id")
  formId          String?   @map("form_id")
  channel         String
  status          String    @default("in_progress")
  transcript      Json      @default("[]")
  formData        Json      @default("{}") @map("form_data")
  aiSummary       String?   @map("ai_summary")
  aiEntities      Json      @default("{}") @map("ai_entities")
  aiUrgency       String?   @map("ai_urgency")
  aiPracticeArea  String?   @map("ai_practice_area")
  aiScore         Int?      @map("ai_score")
  durationSeconds Int?      @map("duration_seconds")
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead    Lead?       @relation(fields: [leadId], references: [id])
  contact Contact?    @relation(fields: [contactId], references: [id])
  form    IntakeForm? @relation(fields: [formId], references: [id])

  @@index([tenantId])
  @@map("intake_sessions")
}

model Communication {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  contactId       String   @map("contact_id")
  leadId          String?  @map("lead_id")
  channel         String
  direction       String
  status          String   @default("sent")
  body            String?
  subject         String?
  fromNumber      String?  @map("from_number")
  toNumber        String?  @map("to_number")
  twilioSid       String?  @map("twilio_sid")
  durationSeconds Int?     @map("duration_seconds")
  sentiment       String?
  sentimentScore  Decimal? @map("sentiment_score") @db.Decimal(3, 2)
  metadata        Json     @default("{}")
  sentByUserId    String?  @map("sent_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead     Lead?   @relation(fields: [leadId], references: [id])
  sentBy   User?   @relation(fields: [sentByUserId], references: [id])

  @@index([tenantId, contactId, createdAt(sort: Desc)])
  @@map("communications")
}

model Appointment {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  leadId          String    @map("lead_id")
  attorneyId      String    @map("attorney_id")
  contactId       String    @map("contact_id")
  type            String    @default("consultation")
  status          String    @default("scheduled")
  startsAt        DateTime  @map("starts_at")
  endsAt          DateTime  @map("ends_at")
  timezone        String    @default("America/New_York")
  location        String?
  meetingUrl      String?   @map("meeting_url")
  notes           String?
  externalEventId String?   @map("external_event_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  attorney Attorney @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
  @@map("appointments")
}

model AutomationWorkflow {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  description    String?
  triggerType    String   @map("trigger_type")
  triggerConfig  Json     @default("{}") @map("trigger_config")
  steps          Json
  isActive       Boolean  @default(true) @map("is_active")
  isSystem       Boolean  @default(false) @map("is_system")
  executionCount Int      @default(0) @map("execution_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@map("automation_workflows")
}

model WorkflowExecution {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  workflowId       String    @map("workflow_id")
  leadId           String    @map("lead_id")
  contactId        String    @map("contact_id")
  status           String    @default("running")
  currentStepIndex Int       @default(0) @map("current_step_index")
  stepResults      Json      @default("[]") @map("step_results")
  nextRunAt        DateTime? @map("next_run_at")
  errorMessage     String?   @map("error_message")
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  lead     Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact  Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([nextRunAt])
  @@map("workflow_executions")
}

model AnalyticsSnapshot {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  snapshotDate DateTime @map("snapshot_date") @db.Date
  metrics      Json
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, snapshotDate])
  @@map("analytics_snapshots")
}

model ReviewRequest {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  leadId      String    @map("lead_id")
  contactId   String    @map("contact_id")
  platform    String
  status      String    @default("pending")
  reviewUrl   String?   @map("review_url")
  messageSent String?   @map("message_sent")
  sentAt      DateTime? @map("sent_at")
  clickedAt   DateTime? @map("clicked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
  @@map("review_requests")
}

model Plan {
  id            String   @id @default(uuid())
  name          String
  stripePriceId String   @map("stripe_price_id")
  monthlyPrice  Decimal  @map("monthly_price") @db.Decimal(10, 2)
  aiCredits     Int      @map("ai_credits")
  smsIncluded   Int      @map("sms_included")
  maxUsers      Int      @map("max_users")
  maxAttorneys  Int      @map("max_attorneys")
  features      Json     @default("{}")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  planId               String    @map("plan_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripeCustomerId     String    @map("stripe_customer_id")
  status               String
  currentPeriodStart   DateTime  @map("current_period_start")
  currentPeriodEnd     DateTime  @map("current_period_end")
  trialEndsAt          DateTime? @map("trial_ends_at")
  cancelledAt          DateTime? @map("cancelled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model UsageEvent {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  userId       String?  @map("user_id")
  eventType    String   @map("event_type")
  model        String?
  tokensInput  Int?     @map("tokens_input")
  tokensOutput Int?     @map("tokens_output")
  creditsUsed  Decimal  @default(0) @map("credits_used") @db.Decimal(10, 4)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@map("usage_events")
}

model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  changes    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_events")
}
